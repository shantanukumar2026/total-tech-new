  ];
];

css_value = css_value.concat(")");

variable output: Color.CSS;
output.value = css_value;
return output;`}},{source:"https://schema.tokenscript.dev.gcp.tokens.studio/api/v1/core/oklch-color/0/",target:"$self",description:"Converts OKLCH to CSS oklch() syntax",lossless:!0,script:{type:"https://schema.tokenscript.dev.gcp.tokens.studio/api/v1/core/tokenscript/0/",script:`// OKLCH to CSS Conversion
// Converts OKLCH to CSS oklch() syntax
// CSS Color Level 4: oklch(L C H) or oklch(L C H / alpha) where L is 0-1 decimal
